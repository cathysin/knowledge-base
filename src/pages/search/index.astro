---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import { CATEGORIES } from '../../data/categories';
import { withBase } from '../../lib/base';
---
<Base topic="搜索" description="在全部主题与归档文章中搜索">
  <div class="page page-search" data-pagefind-ignore="all">
    <Breadcrumb items={[{ label: '首页', href: withBase('/') }, { label: '搜索' }]} />
    <header class="search-heading"><h1 class="page-title">找到你想了解的</h1><p class="page-lead">在所有主题与归档文章中搜索。</p></header>
    <SiteSearch />
    <div class="search-toolbar">
      <p class="result-count" id="result-count" aria-live="polite">输入关键词，开始探索</p>
      <form id="filters" class="search-category-filter" method="get" action={withBase('/search/')} aria-label="筛选搜索分类">
        <input type="hidden" name="q" id="filter-query" />
        <label for="search-category">分类</label>
        <select id="search-category" name="category"><option value="all">全部分类</option>{CATEGORIES.map(category => <option value={category.slug} data-name={category.name}>{category.name}</option>)}</select>
        <button type="submit" class="filter-submit">应用筛选</button>
      </form>
    </div>
    <div id="search-panel" aria-busy="false">
      <div class="search-loading" id="search-loading" hidden><progress aria-label="正在搜索文章"></progress><p>正在载入搜索索引并查找文章</p></div>
      <section class="search-discover" id="search-hint" aria-labelledby="search-discover-heading">
        <h2 id="search-discover-heading">也可以从主题开始</h2>
        <div class="search-topic-links">{CATEGORIES.map(category => <a href={withBase(`/${category.slug}/`)}><span>{category.name}</span><span aria-hidden="true">↗</span></a>)}</div>
      </section>
      <section class="search-state search-error" id="search-error" hidden>
        <h2 role="alert">搜索暂时无法使用</h2><p>索引未能载入，请检查网络后重试。也可以按分类继续浏览。</p>
        <div class="search-state-actions"><button type="button" id="search-retry">重新搜索</button><a href={withBase('/#cats')}>浏览全部分类</a></div>
      </section>
      <section class="search-state" id="search-none" hidden>
        <h2>暂时没有找到匹配内容</h2><p id="search-none-description">试试更短的关键词，或者切换到全部分类。</p>
        <div class="search-state-actions"><a href={withBase('/search/')}>清空搜索</a><a id="search-all-categories" href={withBase('/search/')} hidden>搜索全部分类</a><a href={withBase('/')}>回到首页</a></div>
      </section>
      <ol class="search-list" id="search-list"></ol>
    </div>
    <noscript><p class="search-noscript">全文搜索需要 JavaScript。你也可以通过上方的主题入口浏览归档。</p></noscript>
  </div>
</Base>

<script is:inline type="module">
  const BASE = (() => {
    const raw = document.documentElement.dataset.base || '/';
    return raw.endsWith('/') ? raw : raw + '/';
  })();
  const countEl = document.getElementById('result-count');
  const panelEl = document.getElementById('search-panel');
  const loadingEl = document.getElementById('search-loading');
  const hintEl = document.getElementById('search-hint');
  const errorEl = document.getElementById('search-error');
  const noneEl = document.getElementById('search-none');
  const listEl = document.getElementById('search-list');
  const filters = document.getElementById('filters');
  const categorySelect = document.getElementById('search-category');
  const filterQuery = document.getElementById('filter-query');
  const input = document.getElementById('q');
  const searchForm = input.closest('form');
  const retainedCategory = document.createElement('input');
  retainedCategory.type = 'hidden'; retainedCategory.name = 'category'; searchForm.append(retainedCategory);
  const categories = [...categorySelect.options].filter(option => option.value !== 'all').map(option => ({ slug: option.value, name: option.dataset.name }));
  let query = '', selectedCategory = 'all', allResults = [], requestVersion = 0, pagefindPromise = null;

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  }
  // Only literal, attribute-free mark tags survive; every other tag is escaped.
  function formatExcerpt(html) {
    return String(html || '').split(/(<\/?mark>)/i).map(part => /^<\/?mark>$/i.test(part) ? part.toLowerCase() : escapeHtml(part)).join('');
  }
  function resultUrl(raw) {
    try {
      const url = new URL(String(raw || ''), location.origin + BASE);
      return url.origin === location.origin && url.pathname.startsWith(BASE) ? url.href : null;
    } catch { return null; }
  }
  function cleanTitle(value) {
    return String(value || '').replace(/\s*\|\s*Cathy's Knowledge Base\s*$/, '').trim();
  }
  function readLocation() {
    const params = new URLSearchParams(location.search);
    query = (params.get('q') || '').trim();
    const category = params.get('category') || 'all';
    selectedCategory = categories.some(item => item.slug === category) ? category : 'all';
    input.value = query; filterQuery.value = query; categorySelect.value = selectedCategory;
    retainedCategory.value = selectedCategory; retainedCategory.disabled = selectedCategory === 'all';
  }
  function setState(state) {
    loadingEl.hidden = state !== 'loading'; hintEl.hidden = state !== 'initial';
    errorEl.hidden = state !== 'error'; noneEl.hidden = state !== 'empty'; listEl.hidden = state !== 'results';
    panelEl.setAttribute('aria-busy', String(state === 'loading'));
  }
  function render() {
    listEl.replaceChildren();
    if (!query) { setState('initial'); countEl.textContent = '输入关键词，开始探索'; return; }
    const rows = selectedCategory === 'all' ? allResults : allResults.filter(result => result.categorySlug === selectedCategory);
    countEl.textContent = `“${query}” · ${rows.length} 篇结果`;
    setState(rows.length ? 'results' : 'empty');
    const allLink = document.getElementById('search-all-categories');
    allLink.hidden = selectedCategory === 'all';
    allLink.href = BASE + 'search/?' + new URLSearchParams({ q: query });
    document.getElementById('search-none-description').textContent = selectedCategory === 'all'
      ? '试试更短的关键词，或从分类进入。' : '这个分类中暂无匹配内容。试试其他关键词，或搜索全部分类。';
    for (const result of rows) {
      const li = document.createElement('li'), link = document.createElement('a');
      link.className = 'search-result-link'; link.href = result.url;
      const meta = document.createElement('p'); meta.className = 'search-hit-meta';
      meta.textContent = [result.date, result.categoryName, result.slot].filter(Boolean).join(' · ');
      const title = document.createElement('h2'); title.className = 'search-hit-title'; title.textContent = result.title;
      const excerpt = document.createElement('p'); excerpt.className = 'search-hit-excerpt'; excerpt.innerHTML = formatExcerpt(result.excerpt);
      const arrow = document.createElement('span'); arrow.className = 'search-hit-arrow'; arrow.textContent = '↗'; arrow.setAttribute('aria-hidden', 'true');
      link.append(meta, title, excerpt, arrow); li.append(link); listEl.append(li);
    }
  }
  function getPagefind() {
    if (!pagefindPromise) {
      pagefindPromise = import(BASE + 'pagefind/pagefind.js').then(async pagefind => { await pagefind.init(); return pagefind; })
        .catch(error => { pagefindPromise = null; throw error; });
    }
    return pagefindPromise;
  }
  async function search() {
    const version = ++requestVersion, requestedQuery = query;
    allResults = []; listEl.replaceChildren();
    if (!query) { render(); return; }
    setState('loading'); countEl.textContent = `正在搜索“${query}”`;
    try {
      const pagefind = await getPagefind(); if (version !== requestVersion) return;
      const response = await pagefind.search(requestedQuery); if (version !== requestVersion) return;
      const documents = await Promise.all(response.results.map(result => result.data())); if (version !== requestVersion) return;
      allResults = documents.flatMap(document => {
        const category = categories.find(item => item.name === document.meta?.category || item.slug === document.meta?.category);
        const url = resultUrl(document.url);
        // Missing/unknown category metadata means this is not an article.
        if (!category || !url) return [];
        const title = cleanTitle(document.meta?.title); if (!title) return [];
        return [{ url, title, categorySlug: category.slug, categoryName: category.name, date: document.meta?.date || '', slot: document.meta?.slot || '', excerpt: document.excerpt || '' }];
      });
      render();
    } catch (error) {
      if (version !== requestVersion) return;
      console.error('Unable to search archive', error); setState('error'); countEl.textContent = '';
    }
  }
  function applyCategory() {
    selectedCategory = categorySelect.value;
    retainedCategory.value = selectedCategory; retainedCategory.disabled = selectedCategory === 'all';
    const url = new URL(location.href);
    if (selectedCategory === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', selectedCategory);
    if (url.href !== location.href) history.pushState(null, '', url);
    if (panelEl.getAttribute('aria-busy') !== 'true' && errorEl.hidden) render();
  }
  filters.addEventListener('submit', event => { event.preventDefault(); applyCategory(); });
  categorySelect.addEventListener('change', applyCategory);
  document.getElementById('search-retry').addEventListener('click', search);
  window.addEventListener('popstate', () => {
    const previousQuery = query; readLocation();
    if (previousQuery !== query) search(); else if (panelEl.getAttribute('aria-busy') !== 'true' && errorEl.hidden) render();
  });
  window.addEventListener('pagehide', () => { ++requestVersion; });
  window.addEventListener('pageshow', event => { if (event.persisted) { readLocation(); search(); } });
  readLocation(); search();
</script>

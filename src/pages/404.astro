---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/categories';
import { withBase } from '../lib/base';
---
<Base topic="页面不存在" description="这个地址暂时找不到了。回到首页，或搜索归档文章。">
  <section class="page page-404" data-pagefind-ignore="all" aria-labelledby="not-found-title">
    <p class="not-found-code" aria-label="错误 404">404</p>
    <h1 class="page-title" id="not-found-title">这一页暂时找不到了</h1>
    <p class="page-lead">链接可能已变更。回到首页，或搜索你想找的内容。</p>
    <div class="page-404-actions"><a class="not-found-primary" href={withBase('/')}>回到首页 <span aria-hidden="true">↗</span></a><a class="page-404-search" href={withBase('/search/')}>搜索全部文章 <span aria-hidden="true">→</span></a></div>
    <nav class="not-found-topics" aria-labelledby="not-found-topics-title"><h2 id="not-found-topics-title">继续浏览</h2><div>{CATEGORIES.map(category => <a href={withBase(`/${category.slug}/`)}>{category.name}<span aria-hidden="true">↗</span></a>)}</div></nav>
  </section>
</Base>

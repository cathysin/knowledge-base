---
// 404（方案 7.5）。本身就是报错态；没有加载过程，空态不适用。
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---
<Base topic="页面不存在" description="这个地址没有对应的文章，可能是链接写错了，或文章还没入库。">
  <div class="page page-404" data-pagefind-ignore="all">
    <h1 class="page-title">页面不存在</h1>
    <p class="page-lead">这个地址没有对应的文章，可能是链接写错了，或文章还没入库。</p>
    <p class="page-404-actions">
      <a class="btn-primary" href={withBase('/')}>回到首页</a>
      <a class="page-404-search" href={withBase('/search/')}>去搜索</a>
    </p>
  </div>
</Base>

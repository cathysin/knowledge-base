---
import { render, getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CategoryNavigation from '../../../components/CategoryNavigation.astro';
import ArchiveList from '../../../components/ArchiveList.astro';
import { CATEGORIES } from '../../../data/categories';
import { postsInCategory, postHref, slotLabel, ymd, yearOf, comparePosts, compareSerial, parseLesson, assertBody, type Post, type Lesson } from '../../../lib/posts';
import { withBase } from '../../../lib/base';
export async function getStaticPaths() {
  const paths:{params:{slug:string;entry:string};props:Record<string,unknown>}[]=[];
  const all=await getCollection('posts');
  for(const cat of CATEGORIES) {const posts=all.filter((post)=>post.data.category===cat.slug).sort(comparePosts);for(const year of [...new Set(posts.map((post)=>yearOf(post.data.date)))]) paths.push({params:{slug:cat.slug,entry:String(year)},props:{kind:'year',year}});for(const post of posts){assertBody(post);paths.push({params:{slug:cat.slug,entry:`${ymd(post.data.date)}-${post.data.slot}`},props:{kind:'article',post}});}}
  return paths;
}
interface Props {kind:'year'|'article';year?:number;post?:Post}
const {kind,year,post}=Astro.props;
const cat=CATEGORIES.find((item)=>item.slug===Astro.params.slug);
if(!cat)throw new Error(`未知分类：${Astro.params.slug}`);
const allCategoryPosts=await postsInCategory(cat.slug);
const years=[...new Set(allCategoryPosts.map((item)=>yearOf(item.data.date)))].sort((a,b)=>b-a);
const yearPosts=kind==='year'&&year?allCategoryPosts.filter((item)=>yearOf(item.data.date)===year):[];
let Content:Awaited<ReturnType<typeof render>>['Content']|undefined;
let headings:{depth:number;slug:string;text:string}[]=[];
let prev:Post|undefined,next:Post|undefined,lessonInfo:Lesson|null=null;
let isCourse=false;
if(kind==='article'&&post){
  lessonInfo=parseLesson(post.body);
  const all=(await getCollection('posts')).filter((item)=>item.data.category===cat.slug);
  const lessons=all.map((item)=>({post:item,lesson:parseLesson(item.body)})).filter((item):item is {post:Post;lesson:Lesson}=>item.lesson!==null);
  isCourse=lessonInfo!==null;
  const siblings=isCourse?lessons.sort((a,b)=>compareSerial(a.lesson.serial,b.lesson.serial)).map((item)=>item.post):all.sort(comparePosts);
  const index=siblings.findIndex((item)=>item.id===post.id);
  if(isCourse){prev=index>0?siblings[index-1]:undefined;next=index>=0&&index<siblings.length-1?siblings[index+1]:undefined;}else{next=index>0?siblings[index-1]:undefined;prev=index>=0&&index<siblings.length-1?siblings[index+1]:undefined;}
  const rendered=await render(post);Content=rendered.Content;headings=rendered.headings.filter((heading)=>heading.depth>=2&&heading.depth<=3);
}
const metaDate=post?(post.data.sample?'示例':ymd(post.data.date)):'';
// 摘要与文章开头完全重复时直接展示正文，避免同一段文字出现两次。
const plainForCompare=(text:string)=>text.replace(/\*\*/g,'').replace(/\s/g,'');
const showSummary=post&&!plainForCompare(post.body??'').slice(0,1600).includes(plainForCompare(post.data.summary));
---
{kind==='year'&&year ? (
  <Base topic={`${cat.name} ${year}`} description={cat.desc}>
    <div class="page page-list" data-pagefind-ignore="all"><Breadcrumb items={[{label:'首页',href:withBase('/')},{label:cat.name,href:withBase(`/${cat.slug}/`)},{label:`${year} 年归档`,href:withBase(`/${cat.slug}/${year}/`),current:true}]} /><div class="category-layout"><CategoryNavigation current={cat.slug} /><div class="category-main"><header class="category-heading"><div><h1 class="page-title">{cat.name}</h1><p class="category-description">{year} 年归档 · {cat.desc}</p></div><p class="archive-total"><strong>{yearPosts.length}</strong><span>篇归档</span></p></header><ArchiveList cat={cat} posts={yearPosts} year={year} allYears={years} /><a class="back-to-category" href={withBase(`/${cat.slug}/`)}>回到最新列表 <span aria-hidden="true">→</span></a></div></div></div>
  </Base>
) : post&&Content ? (
  <Base topic={post.data.title} description={post.data.summary}>
    <article class="page page-article" data-category={cat.slug} data-pagefind-body>
      <div data-pagefind-ignore="all"><Breadcrumb items={[{label:'首页',href:withBase('/')},{label:cat.name,href:withBase(`/${cat.slug}/`)}]} /></div>
      <header class="article-heading"><p class="article-category"><a href={withBase(`/${cat.slug}/`)}>{cat.name}</a><span>{slotLabel(post.data.slot)}</span></p><h1 class="page-title" data-pagefind-meta="title">{post.data.title}</h1>{showSummary&&<p class="article-summary">{post.data.summary}</p>}<p class="article-meta"><span class="visually-hidden" data-pagefind-meta="category">{cat.name}</span><time datetime={ymd(post.data.date)} data-pagefind-meta="date">{metaDate}</time><span data-pagefind-meta="slot">{slotLabel(post.data.slot)}</span><span>来源：{post.data.source_bot}</span>{post.data.as_of&&<span>数据截至 {ymd(post.data.as_of)}</span>}</p>{lessonInfo&&<p class="article-lesson"><span class="lesson-serial">{lessonInfo.serial}</span><span>主题 {lessonInfo.topicIndex}/{lessonInfo.topicTotal} · {lessonInfo.topic} · {lessonInfo.section}</span></p>}</header>
      {headings.length>0&&<details class="article-mobile-toc" data-pagefind-ignore="all"><summary>本文目录 <span>{headings.length} 个部分</span></summary><nav aria-label="手机本文目录">{headings.map((heading)=><a href={`#${heading.slug}`} class:list={{'toc-subheading':heading.depth===3}}>{heading.text}</a>)}</nav></details>}
      <div class="article-reading-layout"><div class="article-reading-body"><div class="prose"><Content /></div>
        {post.data.sources&&post.data.sources.length>0&&<section class="article-sources" aria-labelledby="article-sources-heading"><h2 id="article-sources-heading">参考来源</h2><ul>{post.data.sources.map((source)=><li>{/^https?:\/\//.test(source)?<a href={source}>{source}</a>:source}</li>)}</ul></section>}
        {post.data.tags&&post.data.tags.length>0&&<p class="article-tags" data-pagefind-ignore="all">标签：{post.data.tags.join('、')}</p>}
        <div class="article-reading-end" data-pagefind-ignore="all"><p>仅个人学习笔记，不构成投资建议</p><a href={withBase(`/${cat.slug}/`)}>返回{isCourse?'课程目录':cat.name} <span aria-hidden="true">→</span></a></div>
        {(prev||next)&&<nav class="article-neighbors" aria-label={isCourse?'前后课程':'同分类前后文章'} data-pagefind-ignore="all">{prev?<a href={postHref(cat.slug,prev.data.date,prev.data.slot)}><span>{isCourse?'上一课':'较早一篇'}</span><strong>{prev.data.title}</strong><time datetime={ymd(prev.data.date)}>{ymd(prev.data.date)}</time></a>:<div class="article-neighbor-empty">{isCourse?'你正在阅读本主题第一课':'已到最早归档'}</div>}{next?<a href={postHref(cat.slug,next.data.date,next.data.slot)}><span>{isCourse?'下一课':'较新一篇'}</span><strong>{next.data.title}</strong><time datetime={ymd(next.data.date)}>{ymd(next.data.date)}</time></a>:<div class="article-neighbor-empty">{isCourse?'已读到本主题最新一课':'这已是本分类最新文章'}</div>}</nav>}
      </div></div>
    </article>
  </Base>
) : null}
<script>
  const prose = document.querySelector('.prose');
  const firstList = prose?.firstElementChild;
  if (firstList?.tagName === 'UL' && /日期|来源 bot|课程位置|口径|标题|覆盖/.test(firstList.textContent ?? '')) {
    const details = document.createElement('details');
    details.className = 'article-archive-info';
    const summary = document.createElement('summary');
    summary.textContent = '归档信息与数据口径';
    firstList.before(details);
    details.append(summary, firstList);
  }
  document.querySelectorAll<HTMLAnchorElement>('.article-mobile-toc nav a').forEach((link)=>link.addEventListener('click',()=>{const details=link.closest('details');if(details)details.open=false;}));
</script>
